# Copy this file to deploy/production.env and replace every example value.
# Keep the real file outside source control and restrict it to the deployment user.

APP_DOMAIN=ninelens.example.com
ACME_EMAIL=operations@example.com

# Use long, independently generated values.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY_BASE=replace-with-output-from-bin-rails-secret

# Optional capacity tuning.
NINELENS_IMAGE_TAG=latest
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
JOB_CONCURRENCY=1
JOB_THREADS=3
